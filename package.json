{
  "name": "adscript",
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir ./dist",
    "build:css": "tailwindcss -i src/public/css/style.css -o src/public/css/output.css",
    "watch:css": "tailwindcss -i src/public/css/style.css -o src/public/css/output.css --watch"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/csrf-protection": "^7.0.2",
    "@fastify/flash": "^6.0.3",
    "@fastify/formbody": "^8.0.2",
    "@fastify/session": "^11.1.0",
    "@fastify/static": "^8.1.1",
    "@fastify/view": "^10.0.2",
    "@types/bcrypt": "^5.0.2",
    "@types/nunjucks": "^3.2.6",
    "autoprefixer": "^10.4.20",
    "bcrypt": "^5.1.1",
    "fastify": "^5.2.1",
    "nunjucks": "^3.2.4",
    "point-of-view": "^6.3.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.0.12"
  }
}