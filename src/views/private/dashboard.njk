{% extends "layouts/base.njk" %}

{% block content %}
<div class="bg-white p-8 rounded-lg shadow-md">
  <h1 class="text-3xl font-bold mb-6 text-indigo-700">Dashboard</h1>
  
  <div class="bg-indigo-50 border-l-4 border-indigo-500 p-4 mb-6">
    <p class="text-indigo-700">
      Welcome back, <span class="font-semibold">{{ username }}</span>! This is your private dashboard.
    </p>
  </div>
  
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
    <div class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm hover:shadow-md transition-shadow">
      <h2 class="text-xl font-semibold mb-2 text-indigo-600">Profile</h2>
      <p class="text-gray-600 mb-4">View and update your profile information</p>
      <a href="/private/profile" class="text-indigo-600 hover:text-indigo-800 font-medium">
        Go to Profile →
      </a>
    </div>
    
    <div class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm hover:shadow-md transition-shadow">
      <h2 class="text-xl font-semibold mb-2 text-indigo-600">Settings</h2>
      <p class="text-gray-600 mb-4">Manage your account settings</p>
      <a href="#" class="text-indigo-600 hover:text-indigo-800 font-medium">
        Coming Soon →
      </a>
    </div>
    
    <div class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm hover:shadow-md transition-shadow">
      <h2 class="text-xl font-semibold mb-2 text-indigo-600">Analytics</h2>
      <p class="text-gray-600 mb-4">View your usage statistics</p>
      <a href="#" class="text-indigo-600 hover:text-indigo-800 font-medium">
        Coming Soon →
      </a>
    </div>
  </div>
  
  <div class="border-t border-gray-200 pt-6">
    <h2 class="text-xl font-semibold mb-4 text-indigo-600">Recent Activity</h2>
    <p class="text-gray-600">No recent activity to display.</p>
  </div>
</div>
{% endblock %}
