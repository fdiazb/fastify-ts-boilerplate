{% extends "layouts/base.njk" %}

{% block content %}
<div class="bg-white p-8 rounded-lg shadow-md">
  <h1 class="text-3xl font-bold mb-6 text-indigo-700">Welcome to Fastify TS App</h1>
  
  <p class="mb-4">This is a modular web application built with:</p>
  
  <ul class="list-disc pl-6 mb-6 space-y-2">
    <li>TypeScript for type safety</li>
    <li>Fastify for high-performance server</li>
    <li>Nunjucks for templating</li>
    <li>Tailwind CSS for styling</li>
    <li>Bun as the JavaScript runtime</li>
  </ul>
  
  <p class="mb-6">The application includes authentication with user registration and login functionality.</p>
  
  {% if isAuthenticated %}
    <a href="/private" class="inline-block bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-4 rounded">
      Go to Dashboard
    </a>
  {% else %}
    <div class="flex space-x-4">
      <a href="/auth/login" class="inline-block bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-4 rounded">
        Login
      </a>
      <a href="/auth/register" class="inline-block bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-4 rounded">
        Register
      </a>
    </div>
  {% endif %}
</div>
{% endblock %}
